# Copy to .sandcastle/.env (mode 600). Never commit .sandcastle/.env.
# Sandcastle injects the keys of this file into the loop containers.
#
# Fine-grained PAT for tomiwu/cemetery-run-demo only:
# Contents, Issues, Pull requests, Workflows, Administration (read/write).
# scripts/start-loop.sh overwrites GH_TOKEN from /workspace/cemetery-run-demo-secrets/gh-pat.
GH_TOKEN=
# Claude Code (the loop agent). Reuse the token of the other box loops. Do not commit it.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-sonnet-5-5
PROJECT=cemetery-run-demo
STATUS_FILE=/tmp/cemetery-run-demo-loop.status.json
MAX_ITERATIONS=40
# Merge rule (Tomasz, 2026-11-26): squash-merge only when every required CI job has conclusion success.
AUTO_MERGE=1
REQUIRED_JOBS=format,lint,typecheck,test,build,e2e
SANDCASTLE_IMAGE=localhost/sandcastle:cemetery-run-demo
# Do NOT put LOOP_WEBHOOK_URL or LOOP_WEBHOOK_KEY in this file (it enters the containers).
# The start script loads them from /workspace/cemetery-run-demo-secrets/ into the
# orchestrator process only (header: Authorization: Bearer <key>).
